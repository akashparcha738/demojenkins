pipeline {
    agent any
tools name: 'jenkins-maven', type: 'maven'

    stages {
        stage('Build') {
            steps {
                echo 'Building the project...'
            //sh 'mvn package'
            sh 'mvn --version'
            }
        }

        stage('Test') {
steps {
                echo 'Running tests...'
                //sh 'mvn test'
            }
        }

        stage('Deploy to staging') {
            steps {
                echo 'Deploying the project on staging environment...'
            input 'continue'
            }
        }
    stage('Deploy to production') {
            steps {
                echo 'Deploying the project on production environment...'
            }
        }
    }
    post 
{
        always {
            echo 'This will always run after the stages.'
        }
        success {
            echo 'This will run only if the pipeline succeeds.'
        }
        failure {
            echo 'This will run only if the pipeline fails.'
        }
    }
}




